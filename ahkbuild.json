{
  "entry": "ahklint.ahk",
  "interpreter": {
    "version": "2.1-alpha.30",
    "bitness": 64
  },
  "exe": {
    "name": "ahklint",
    "company": "Tao Beloney",
    "version": "0.1.0.0",
    "subsystem": "console",
    "copyright": "Copyright 2026 Tao Beloney",
    "description": "AutoHotkey v2/v2.1 linter",
    "icon": "assets/emoji-mag.ico"
  },
  "resources": {
    "extra": [
      {
        "name": "LICENSE",
        "type": "RT_RCDATA",
        "path": "LICENSE"
      }
    ]
  },
  "scripts": {
    "pre-bundle": [
      [
        "${AHK}",
        "/ErrorStdOut=UTF-8",
        "./build/barrel.ahk"
      ],
      [
        "${AHK}",
        "/ErrorStdOut=UTF-8",
        "/Validate",
        "${AHKBUILD_ENTRY}"
      ]
    ],
    "post-bundle": []
  },
  "dependencies": {
    "cJson": {
      "git": "git@github.com:G33kDude/cJson.ahk.git",
      "rev": "ea5313ce0e5e79aadcb367e7167c1da991717de3",
      "subdir": "dist"
    },
    "tree-sitter.ahk": {
      "git": "git@github.com:holy-tao/tree-sitter.ahk.git",
      "alias": "treesitter",
      "branch": "feat/v2.1-support",
      "subdir": "src"
    },
    "AhkExtensions": {
      "git": "git@github.com:holy-tao/AhkExtensions.git",
      "alias": "extensions"
    },
    "ahkcollections": {
      "git": "git@github.com:holy-tao/ahkcollections.git",
      "alias": "collections"
    },
    "ahk-utils": {
      "git": "git@github.com:holy-tao/ahk-utils.git",
      "alias": "utils"
    }
  }
}
