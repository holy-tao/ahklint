{
    "target":  "2.1-alpha.30",
    "extends": "recommended",
    "includes": ["**/*.ahk"],
    "excludes": [
      ".ahkbuild/**/*.*",
      "build/**/*.*",
      "tests/YUnit/**/*.*",
      "src/lints/all.ahk"
    ],
    "lints": {
        "no-goto": "error",
        "one-requires": "error",
        "quote-style": ["warn", {"style": "double"}],
        "control-flow-parentheses": ["warn", {"style": "forbidden"}],
        "naming-conventions": "error",
        "call-statement": "error",
        "concat-style": ["warn", {
            "style": "implicit",
            "requireExplicitForNonLiteral": true
        }]
    }
}
